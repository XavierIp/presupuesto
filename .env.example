# Postgres (Prisma Postgres en Vercel). Usa la URL directa postgres://…@db.prisma.io
DATABASE_URL="postgresql://usuario:clave@host/neondb?sslmode=require"

# Secreto para firmar sesiones. Genera uno con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# URL pública de la app. En local: http://localhost:3000
# En Vercel no hace falta: se usa la URL de producción automáticamente.
BETTER_AUTH_URL="http://localhost:3000"

# Zona horaria para calcular "hoy" y los vencimientos (por defecto America/Lima).
APP_TIME_ZONE="America/Lima"
